{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Standard-Berechtigungen für das NovaPhonic Hauptfenster, inklusive Ausführung der drei gebündelten Sidecar Programme",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "binaries/auto-editor", "sidecar": true },
        { "name": "binaries/deep-filter", "sidecar": true },
        { "name": "binaries/ffmpeg", "sidecar": true }
      ]
    }
  ]
}
